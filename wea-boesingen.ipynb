    "# ============================================================================\n",
    "# CZML FÜR CESIUM ERSTELLEN (mit glTF-Modellen)\n",
    "# ============================================================================\n",
    "# CZML ist Cesiums natives JSON-Format. Die Windturbinen werden als glTF-Modelle\n",
    "# referenziert für fotorealistische 3D-Darstellung.\n",
    "\n",
    "import json\n",
    "\n",
    "def create_czml_turbine_model(turbine_id, name, lon, lat, model_file, \n",
    "                               rotor_heading=225, scale=1.0):\n",
    "    \"\"\"Erstellt ein CZML-Paket für eine Windturbine mit glTF-Modell.\"\"\"\n",
    "    return {\n",
    "        \"id\": turbine_id,\n",
    "        \"name\": name,\n",
    "        \"position\": {\n",
    "            \"cartographicDegrees\": [lon, lat, 0]  # Modell steht auf dem Boden\n",
    "        },\n",
    "        \"model\": {\n",
    "            \"gltf\": f\"models/{model_file}\",\n",
    "            \"scale\": scale,\n",
    "            \"minimumPixelSize\": 64,\n",
    "            \"maximumScale\": 20000,\n",
    "            \"heightReference\": \"RELATIVE_TO_GROUND\",\n",
    "            \"silhouetteColor\": {\n",
    "                \"rgba\": [255, 255, 255, 255]\n",
    "            },\n",
    "            \"silhouetteSize\": 1.0\n",
    "        },\n",
    "        \"orientation\": {\n",
    "            \"heading\": math.radians(rotor_heading),\n",
    "            \"pitch\": 0,\n",
    "            \"roll\": 0\n",
    "        }\n",
    "    }\n",
    "\n",
    "\n",
    "def create_czml_polygon(polygon_id, name, coordinates, color=[255, 255, 0, 100], \n",
    "                        outline_color=[255, 0, 0, 255], height=0, extrude=False):\n",
    "    \"\"\"Erstellt ein CZML-Polygon-Paket.\"\"\"\n",
    "    czml_coords = []\n",
    "    for coord in coordinates:\n",
    "        czml_coords.extend([coord[0], coord[1], coord[2] if len(coord) > 2 else height])\n",
    "    \n",
    "    polygon_props = {\n",
    "        \"positions\": {\n",
    "            \"cartographicDegrees\": czml_coords\n",
    "        },\n",
    "        \"material\": {\n",
    "            \"solidColor\": {\n",
    "                \"color\": {\n",
    "                    \"rgba\": color\n",
    "                }\n",
    "            }\n",
    "        },\n",
    "        \"outline\": True,\n",
    "        \"outlineColor\": {\n",
    "            \"rgba\": outline_color\n",
    "        },\n",
    "        \"outlineWidth\": 2\n",
    "    }\n",
    "    \n",
    "    if extrude:\n",
    "        polygon_props[\"extrudedHeight\"] = 0\n",
    "        polygon_props[\"height\"] = height\n",
    "    \n",
    "    return {\n",
    "        \"id\": polygon_id,\n",
    "        \"name\": name,\n",
    "        \"polygon\": polygon_props\n",
    "    }\n",
    "\n",
    "\n",
    "# Mapping von DAE-Modellen zu GLB-Modellen\n",
    "dae_to_glb = {dae: dae.replace('.dae', '.glb') for dae in glb_models.keys()}\n",
    "\n",
    "# CZML-Dokument erstellen\n",
    "czml_document = [\n",
    "    {\n",
    "        \"id\": \"document\",\n",
    "        \"name\": \"Windpark Bösingen\",\n",
    "        \"version\": \"1.0\",\n",
    "        \"clock\": {\n",
    "            \"currentTime\": \"2025-01-01T00:00:00Z\",\n",
    "            \"multiplier\": 1\n",
    "        }\n",
    "    }\n",
    "]\n",
    "\n",
    "# Windturbinen aus CSV-Dateien laden\n",
    "print(\"Erstelle CZML mit glTF-Modellen...\")\n",
    "turbine_count = 0\n",
    "\n",
    "for csv_file in glob.glob('locations/*.csv'):\n",
    "    folder_name = os.path.splitext(os.path.basename(csv_file))[0]\n",
    "    \n",
    "    try:\n",
    "        df = csv2df(csv_file)\n",
    "        visible_turbines = df[df['visible'] == 1]\n",
    "        \n",
    "        for _, row in visible_turbines.iterrows():\n",
    "            turbine_id = row['Name'].replace(' ', '_').replace('-', '_')\n",
    "            dae_model = row['Model']\n",
    "            glb_model = dae_to_glb.get(dae_model, dae_model.replace('.dae', '.glb'))\n",
    "            \n",
    "            packet = create_czml_turbine_model(\n",
    "                turbine_id=turbine_id,\n",
    "                name=row['Name'],\n",
    "                lon=row['Longitude'],\n",
    "                lat=row['Latitude'],\n",
    "                model_file=glb_model,\n",
    "                rotor_heading=ROTOR_ORIENTATION,\n",
    "                scale=1.0\n",
    "            )\n",
    "            czml_document.append(packet)\n",
    "            turbine_count += 1\n",
    "            \n",
    "    except Exception as e:\n",
    "        print(f\"  Fehler bei {csv_file}: {e}\")\n",
    "\n",
    "print(f\"  {turbine_count} Windturbinen (glTF-Modelle)\")\n",
    "\n",
    "# Windvorranggebiete als Polygone\n",
    "wvg_count = 0\n",
    "for wvg_file in sorted(glob.glob('areas/windvorranggebiet_*.csv')):\n",
    "    basename = os.path.splitext(os.path.basename(wvg_file))[0]\n",
    "    number = basename.split('_')[-1]\n",
    "    name = f\"Windvorranggebiet {number}\"\n",
    "    \n",
    "    try:\n",
    "        df = pd.read_csv(wvg_file)\n",
    "        coordinates = list(zip(df['Longitude'], df['Latitude'], df['Altitude']))\n",
    "        \n",
    "        polygon_packet = create_czml_polygon(\n",
    "            polygon_id=f\"wvg_{number}\",\n",
    "            name=name,\n",
    "            coordinates=coordinates,\n",
    "            color=[255, 255, 0, 80],\n",
    "            outline_color=[255, 0, 0, 255]\n",
    "        )\n",
    "        czml_document.append(polygon_packet)\n",
    "        wvg_count += 1\n",
    "    except:\n",
    "        pass\n",
    "\n",
    "print(f\"  {wvg_count} Windvorranggebiete\")\n",
    "\n",
    "# Flugplatz Landebahn\n",
    "landebahn_coords = [\n",
    "    (8.531799515709411, 48.22788047237495, 0),\n",
    "    (8.531791237373254, 48.22746570381057, 0),\n",
    "    (8.537614083339131, 48.22746248646123, 0),\n",
    "    (8.537607267242425, 48.22789309924998, 0),\n",
    "]\n",
    "czml_document.append(create_czml_polygon(\n",
    "    polygon_id=\"airfield_runway\",\n",
    "    name=\"Landebahn Bösingen\",\n",
    "    coordinates=landebahn_coords,\n",
    "    color=[0, 0, 255, 100],\n",
    "    outline_color=[0, 0, 255, 255]\n",
    "))\n",
    "print(\"  Flugplatz\")\n",
    "\n",
    "# CZML speichern\n",
    "output_czml = './output/WEA-boesingen.czml'\n",
    "with open(output_czml, 'w', encoding='utf-8') as f:\n",
