    "    }\n",
    "    return colors.get(folder_name.lower(), simplekml.Color.firebrick)\n",
    "\n",
    "\n",
    "# Alle CSV-Dateien im locations-Verzeichnis verarbeiten\n",
    "csv_files = glob.glob('locations/*.csv')\n",
    "total_turbines = 0\n",
    "\n",
    "for csv_file in csv_files:\n",
    "    folder_name = os.path.splitext(os.path.basename(csv_file))[0].title()\n",
    "    print(f\"Verarbeite: {folder_name}\")\n",
    "\n",
    "    if DIRECTORY_NESTING:\n",
    "        folder = kml.newfolder(name=folder_name)\n",
    "        folder.visibility = 0\n",
    "\n",
    "    folder_model = folder.newfolder(name='Modell') if DIRECTORY_NESTING else kml.newfolder(name=f'{folder_name}-Modell')\n",
    "    folder_model.visibility = 1\n",
    "\n",
    "    folder_extent = folder.newfolder(name='Umfang') if DIRECTORY_NESTING else kml.newfolder(name=f'{folder_name}-Umfang')\n",
    "    folder_extent.visibility = 0\n",
    "\n",
    "    if folder_name.lower() == 'testturm':\n",
    "        folder_safety = None\n",
    "        folder_marker = None\n",
    "        markerstyle = None\n",
    "        folder.visibility = 1\n",
    "    else:\n",
    "        folder_safety = folder.newfolder(name='Sicherheitsabstand') if DIRECTORY_NESTING else kml.newfolder(name=f'{folder_name}-Sicherheitsabstand')\n",
    "        folder_safety.visibility = 0\n",
    "        folder_marker = folder.newfolder(name='Standorte') if DIRECTORY_NESTING else kml.newfolder(name=f'{folder_name}-Standorte')\n",
    "        folder_marker.visibility = 0\n",
    "        markerstyle = get_marker_style(folder_name)\n",
    "\n",
    "    try:\n",
    "        df = csv2df(csv_file)\n",
    "        color_extent = get_extent_color(folder_name)\n",
    "        visible_turbines = df[df['visible'] == 1]\n",
    "        \n",
    "        visible_turbines.apply(lambda row: add_turbine(\n",
    "            row, folder, folder_model, folder_extent, folder_safety, \n",
    "            folder_marker, markerstyle, color_extent=color_extent, visibility=1\n",
    "        ), axis=1)\n",
    "        \n",
    "        count = len(visible_turbines)\n",
    "        total_turbines += count\n",
    "        if len(df) != count:\n",
    "            print(f\"  -> {count}/{len(df)} sichtbare Turbinen\")\n",
    "        else:\n",
    "            print(f\"  -> {count} Turbinen\")\n",
    "    except Exception as e:\n",
    "        print(f\"  -> Fehler: {e}\")\n",
    "\n",
    "print(f\"\\nGesamt: {total_turbines} Turbinen aus {len(csv_files)} CSV-Dateien\")"
