    "# ============================================================================\n",
    "# KMZ ERSTELLEN (KML + 3D-Modelle für Google Earth Pro)\n",
    "# ============================================================================\n",
    "\n",
    "import zipfile\n",
    "\n",
    "def create_kmz(kml_filename, dae_filenames, output_filename):\n",
    "    \"\"\"Erstellt KMZ-Archiv aus KML und DAE-Dateien\"\"\"\n",
    "    with zipfile.ZipFile(output_filename, 'w') as kmz:\n",
    "        kmz.write(kml_filename)\n",
    "        for dae in dae_filenames:\n",
    "            kmz.write(dae, os.path.join(modeldir, os.path.basename(dae)))\n",
    "\n",
    "# Listet alle .dae-Dateien im \"model\"-Verzeichnis auf\n",
    "\n",
    "dae_files = [os.path.join(modeldir, f) for f in os.listdir(modeldir) if f.endswith('.dae')]\n",
    "output_file =  os.path.join('.','output','WEA-boesingen.kmz')\n",
    "create_kmz(kml_file, dae_files, output_file)\n"
    "            kmz.write(dae)\n",
    "\n",
    "# Alle DAE-Modelle sammeln\n",
    "dae_files = [\n",
    "    os.path.join(CONFIG['models_dir'], f) \n",
    "    for f in os.listdir(CONFIG['models_dir']) \n",
    "    if f.endswith('.dae')\n",
    "]\n",
    "\n",
    "# Pro-Version mit COLLADA-Modellen\n",
    "output_kmz_pro = './output/WEA-boesingen-pro.kmz'\n",
    "create_kmz(CONFIG['output_kml'], dae_files, output_kmz_pro)\n",
    "\n",
    "print(f\"KMZ für Google Earth Pro erstellt: {output_kmz_pro}\")\n",
    "print(f\"  - Enthält {len(dae_files)} 3D-Modelle (COLLADA)\")\n",
    "print(f\"  - Für beste Darstellung in Google Earth Pro Desktop öffnen\")"
   ]
  },
