   "source": [
    "# ============================================================================\n",
    "# WEB-KOMPATIBLE KMZ ERSTELLEN (ohne COLLADA-Modelle)\n",
    "# ============================================================================\n",
    "# Diese Version verwendet vereinfachte KML-Geometrie statt COLLADA-Modellen\n",
    "# und funktioniert in Google Earth Web, iPad, und anderen KML-Viewern.\n",
    "\n",
    "def get_turbine_color(folder_name):\n",
    "    \"\"\"Gibt passende Farben für Turm, Gondel und Rotor basierend auf Ordnernamen zurück\"\"\"\n",
    "    color_map = {\n",
    "        'badenova': (simplekml.Color.lightblue, simplekml.Color.blue, simplekml.Color.white),\n",
    "        'iterra': (simplekml.Color.orange, simplekml.Color.darkorange, simplekml.Color.white),\n",
    "        'testturm': (simplekml.Color.silver, simplekml.Color.gray, simplekml.Color.silver),\n",
    "    }\n",
    "    # Default: weiß/grau\n",
    "    return color_map.get(folder_name.lower(), (simplekml.Color.white, simplekml.Color.lightgray, simplekml.Color.white))\n",
    "\n",
    "# Neues KML-Dokument für Web-Version\n",
    "kml_web = simplekml.Kml()\n",
