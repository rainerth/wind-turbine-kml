    "# ============================================================================\n",
    "# FREIFLÄCHEN-PHOTOVOLTAIK (FFPV) AUS SHAPEFILE LADEN\n",
    "# ============================================================================\n",
    "# Lädt PV-Gebiete aus dem RVSBH Shapefile und fügt sie als Layer hinzu.\n",
    "# Die Daten werden von EPSG:25832 (UTM 32N) nach WGS84 transformiert.\n",
    "\n",
    "import geopandas as gpd\n",
    "\n",
    "# Shapefile-Pfad\n",
    "shp_path = \"areas/RVSBH_Teilplan_FFPV/RVSBH_Teilplan_FFPV Stand n2_Bet/RVSBH_Teilplan_FFPV_Stand_n2_Bet.shp\"\n",
    "\n",
    "try:\n",
    "    # Shapefile laden und nach WGS84 transformieren\n",
    "    gdf_pv = gpd.read_file(shp_path)\n",
    "    gdf_pv = gdf_pv.to_crs(epsg=4326)\n",
    "    \n",
    "    # Auf relevanten Bereich filtern (Bösingen-Region)\n",
    "    gdf_pv_filtered = gdf_pv.cx[\n",
    "        CONFIG['area_lon_min']:CONFIG['area_lon_max'],\n",
    "        CONFIG['area_lat_min']:CONFIG['area_lat_max']\n",
    "    ]\n",
    "    \n",
    "    print(f\"FFPV-Shapefile geladen: {len(gdf_pv)} Gebiete total\")\n",
    "    print(f\"  -> {len(gdf_pv_filtered)} Gebiete im Projektbereich\")\n",
    "    \n",
    "    if len(gdf_pv_filtered) > 0:\n",
    "        # KML-Ordner erstellen\n",
    "        folder_pv = kml.newfolder(name='Freiflächen-PV (FFPV)')\n",
    "        folder_pv.visibility = 0\n",
    "        \n",
    "        pv_count = 0\n",
    "        for idx, row in gdf_pv_filtered.iterrows():\n",
    "            geom = row.geometry\n",
    "            name = row.get('Bez', f\"PV-Gebiet {row.get('Gebietsnum', idx)}\")\n",
    "            gemeinde = row.get('Gemeinde', 'Unbekannt')\n",
    "            \n",
    "            # MultiPolygon oder Polygon verarbeiten\n",
    "            if geom.geom_type == 'MultiPolygon':\n",
    "                polygons = list(geom.geoms)\n",
    "            else:\n",
    "                polygons = [geom]\n",
    "            \n",
    "            for i, poly in enumerate(polygons):\n",
    "                # Koordinaten extrahieren (exterior ring) - nur x, y verwenden\n",
    "                coords = [(coord[0], coord[1], 0) for coord in poly.exterior.coords]\n",
    "                \n",
    "                poly_name = f\"{name}\" if len(polygons) == 1 else f\"{name} ({i+1})\"\n",
    "                \n",
    "                pol = folder_pv.newpolygon(\n",
    "                    name=poly_name,\n",
    "                    outerboundaryis=coords,\n",
    "                    altitudemode=simplekml.AltitudeMode.clamptoground\n",
    "                )\n",
    "                # Orange Farbe für PV-Gebiete\n",
    "                pol.style.polystyle.color = simplekml.Color.changealphaint(100, simplekml.Color.orange)\n",
    "                pol.style.linestyle.color = simplekml.Color.darkorange\n",
    "                pol.style.linestyle.width = 2\n",
    "                pol.description = f\"Gemeinde: {gemeinde}<br/>Gebietsnummer: {row.get('Gebietsnum', '-')}\"\n",
    "                pv_count += 1\n",
    "        \n",
    "        print(f\"  -> {pv_count} FFPV-Polygone zum KML hinzugefügt\")\n",
    "    else:\n",
    "        print(\"  -> Keine FFPV-Gebiete im Projektbereich gefunden\")\n",
    "        \n",
    "except FileNotFoundError:\n",
    "    print(f\"FFPV-Shapefile nicht gefunden: {shp_path}\")\n",
    "except Exception as e:\n",
    "    print(f\"Fehler beim Laden des FFPV-Shapefiles: {e}\")"
   ]
  },
