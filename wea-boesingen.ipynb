    "<html lang=\"de\">\n",
    "<head>\n",
    "    <meta charset=\"UTF-8\">\n",
    "    <title>Windpark Bösingen - Cesium</title>\n",
    "    <script src=\"https://cesium.com/downloads/cesiumjs/releases/1.114/Build/Cesium/Cesium.js\"></script>\n",
    "    <link href=\"https://cesium.com/downloads/cesiumjs/releases/1.114/Build/Cesium/Widgets/widgets.css\" rel=\"stylesheet\">\n",
    "    <style>\n",
    "        html, body, #cesiumContainer {{ width: 100%; height: 100%; margin: 0; padding: 0; overflow: hidden; }}\n",
    "    </style>\n",
    "</head>\n",
    "<body>\n",
    "    <div id=\"cesiumContainer\"></div>\n",
    "    <script>\n",
    "        // Cesium ion Access Token (Read-Only)\n",
    "        Cesium.Ion.defaultAccessToken = '{cesium_token}';\n",
    "\n",
    "        const viewer = new Cesium.Viewer(\"cesiumContainer\", {{\n",
    "            terrain: Cesium.Terrain.fromWorldTerrain()\n",
    "        }});\n",
    "\n",
    "        // Rotor heading (225° = Southwest)\n",
    "        const rotorHeading = Cesium.Math.toRadians({ROTOR_ORIENTATION});\n",
    "        const hpr = new Cesium.HeadingPitchRoll(rotorHeading, 0, 0);\n",
    "\n",
    "        // Turbine data\n",
    "        const turbines = {json.dumps(turbines_js)};\n",
    "\n",
    "        // Add turbines\n",
    "        turbines.forEach(t => {{\n",
    "            const position = Cesium.Cartesian3.fromDegrees(t.lon, t.lat, 0);\n",
    "            const orientation = Cesium.Transforms.headingPitchRollQuaternion(position, hpr);\n",
    "\n",
    "            Cesium.IonResource.fromAssetId(t.assetId).then(resource => {{\n",
    "                viewer.entities.add({{\n",
    "                    name: t.name,\n",
    "                    position: position,\n",
    "                    orientation: orientation,\n",
    "                    model: {{\n",
    "                        uri: resource,\n",
    "                        heightReference: Cesium.HeightReference.CLAMP_TO_GROUND,\n",
    "                        minimumPixelSize: 64\n",
    "                    }}\n",
    "                }});\n",
    "            }});\n",
    "        }});\n",
    "\n",
    "        // Wind priority areas (RVSBH Shapefile) - Yellow\n",
    "        const wvgCoords = {json.dumps(wvg_coords_js)};\n",
    "\n",
    "        Object.entries(wvgCoords).forEach(([id, coords]) => {{\n",
    "            const positions = Cesium.Cartesian3.fromDegreesArray(coords);\n",
    "            viewer.entities.add({{\n",
    "                name: \"Windvorranggebiet \" + id.replace(\"wvg\", \"\"),\n",
    "                polygon: {{\n",
    "                    hierarchy: positions,\n",
    "                    material: Cesium.Color.YELLOW.withAlpha(0.3),\n",
    "                    outline: true,\n",
    "                    outlineColor: Cesium.Color.RED,\n",
    "                    outlineWidth: 2\n",
    "                }}\n",
    "            }});\n",
    "        }});\n",
    "\n",
    "        // FFPV areas (polygons) - Orange\n",
    "        const ffpvData = {json.dumps(ffpv_coords_js)};\n",
    "\n",
    "        Object.entries(ffpvData).forEach(([id, data]) => {{\n",
    "            const positions = Cesium.Cartesian3.fromDegreesArray(data.coords);\n",
    "            viewer.entities.add({{\n",
    "                name: \"FFPV: \" + data.name,\n",
    "                polygon: {{\n",
    "                    hierarchy: positions,\n",
    "                    material: Cesium.Color.ORANGE.withAlpha(0.3),\n",
    "                    outline: true,\n",
    "                    outlineColor: Cesium.Color.DARKORANGE,\n",
    "                    outlineWidth: 2\n",
    "                }}\n",
    "            }});\n",
    "        }});\n",
    "\n",
    "        // Fly to Bösingen\n",
    "        viewer.camera.flyTo({{\n",
    "            destination: Cesium.Cartesian3.fromDegrees(8.534, 48.25, 5000),\n",
    "            orientation: {{\n",
    "                heading: Cesium.Math.toRadians(0),\n",
    "                pitch: Cesium.Math.toRadians(-45),\n",
    "                roll: 0\n",
    "            }}\n",
    "        }});\n",
    "    </script>\n",
    "</body>\n",
    "</html>'''\n",
    "\n",
    "    # HTML speichern\n",
    "    output_html = './output/windpark-cesium.html'\n",
    "    with open(output_html, 'w', encoding='utf-8') as f:\n",
    "        f.write(html_content)\n",
    "    \n",
    "    print(f\"Cesium HTML-Viewer erstellt: {output_html}\")\n",
    "    print(f\"  - {len(turbines_js)} Windturbinen\")\n",
    "    print(f\"  - {len(wvg_coords_js)} Windvorranggebiete (RVSBH)\")\n",
    "    print(f\"  - {len(ffpv_coords_js)} FFPV-Gebiete\")\n",
    "    print(\"  - Token aus .env geladen (CESIUM_ION_TOKEN_READONLY)\")\n",
    "    print(\n",
    "        \"\\nHinweis: Die HTML-Datei kann lokal geöffnet oder auf einem \"\n",
    "        \"Webserver gehostet werden.\"\n",
    "    )"
   ]
  },
