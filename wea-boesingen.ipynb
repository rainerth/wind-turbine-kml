    "# ============================================================================\n",
    "# WINDTURBINEN AUS CSV LADEN\n",
    "# ============================================================================\n",
    "\n",
    "def add_turbine(row, folder, folder_model, folder_extent, folder_safety, \n",
    "                folder_marker, markerstyle, color_extent=simplekml.Color.firebrick, visibility=1):\n",
    "    \"\"\"Fügt eine Windturbine mit allen zugehörigen KML-Elementen hinzu\"\"\"\n",
    "    name = row['Name']\n",
    "    daemodel = row['Model']\n",
    "    latitude = row['Latitude']\n",
    "    longitude = row['Longitude']\n",
    "    height = row['height']\n",
    "    diameter = row['diameter']\n",
    "\n",
    "    turbine_visible = row.get('visible', 1)\n",
    "    actual_visibility = visibility if turbine_visible == 1 else 0\n",
    "\n",
    "    # 3D-Modell (nur in Google Earth Pro Desktop sichtbar)\n",
    "    turbine = folder_model.newmodel(name=name)\n",
    "    turbine.link.href = f\"{CONFIG['models_dir']}/{daemodel}\"\n",
    "    turbine.location.latitude = latitude\n",
    "    turbine.location.longitude = longitude\n",
    "    turbine.scale.x = 1\n",
    "    turbine.scale.y = 1\n",
    "    turbine.scale.z = 1\n",
    "    turbine.visibility = actual_visibility\n",
    "    turbine.orientation.heading = ROTOR_ORIENTATION\n",
    "\n",
    "    # Umfang als Zylinder\n",
    "    create_kml_cylinder(\n",
    "        kmlfolder=folder_extent,\n",
    "        cyl_center=(longitude, latitude),\n",
    "        cyl_diameter=diameter,\n",
    "        cyl_height=height + diameter/2,\n",
    "        cyl_color=color_extent,\n",
    "        cyl_name=name,\n",
    "        cyl_visibility=0\n",
    "    )\n",
    "\n",
    "    # Sicherheitszone als Zylinder\n",
    "    safety_distance = max(safety_distance_meter, diameter * safety_distance_factor)\n",
    "    if folder_safety is not None:\n",
    "        create_kml_cylinder(\n",
    "            kmlfolder=folder_safety,\n",
    "            cyl_center=(longitude, latitude),\n",
    "            cyl_diameter=diameter + safety_distance*2,\n",
    "            cyl_height=height + diameter/2 + safety_distance_top,\n",
    "            cyl_color=simplekml.Color.lightgray,\n",
    "            cyl_name=name,\n",
    "            cyl_visibility=0\n",
    "        )\n",
    "\n",
    "    # Standort-Marker\n",
    "    if folder_marker is not None and markerstyle is not None:\n",
    "        location = folder_marker.newpoint(name=name, coords=[(longitude, latitude)])\n",
    "        location.style = markerstyle\n",
    "        location.visibility = 0\n",
    "\n",
    "\n",
    "\treturn df\n",
    "\n",
    "def add_turbine(row, folder,\n",
    "\t  \tfolder_model,\n",
    "\t\tfolder_extent,\n",
    "\t\tfolder_safety,\n",
    "\t\tfolder_marker,\n",
    "\t\tmarkerstyle,\n",
    "\t\tcolor_extent=simplekml.Color.firebrick,\n",
    "\t\tvisibility=1):\n",
    "\n",
    "\tname = row['Name']\n",
    "\tdaemodel = row['Model']\n",
    "\tlatitude = row['Latitude']\n",
