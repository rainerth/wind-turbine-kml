    "# ============================================================================\n",
    "# FLUGTRACKS AUS IGC-DATEIEN\n",
    "# ============================================================================\n",
    "\n",
    "folder = kml.newfolder(name='Tracks.IGC')\n",
    "folder.visibility = 0\n",
    "\n",
    "igc_directory = os.path.join('tracks', 'igc')\n",
    "igc_files = glob.glob(f'{igc_directory}/*.igc')\n",
    "\n",
    "tracks_added = 0\n",
    "tracks_skipped = 0\n",
    "\n",
    "for igc_path in igc_files:\n",
    "    try:\n",
    "        track, flight_url, flight_name = igc_extract_launch_phase(\n",
    "            igc_path, min_altitude=710, max_altitude=1500, min_climb_rate=0\n",
    "        )\n",
    "        \n",
    "        if track is None:\n",
    "            tracks_skipped += 1\n",
    "            continue\n",
    "            \n",
    "        coordinates = track[['Longitude', 'Latitude', 'Altitude']].values.tolist()\n",
    "        \n",
    "        # Prüfen ob Track im definierten Gebiet liegt\n",
    "        if not is_in_area(coordinates[0][0], coordinates[0][1]):\n",
    "            print(f\"  Übersprungen (außerhalb Gebiet): {flight_name}\")\n",
    "            tracks_skipped += 1\n",
    "            continue\n",
    "        \n",
    "        create_kml_line(folder, coordinates, flight_name, flight_url, simplekml.Color.mediumpurple)\n",
    "        tracks_added += 1\n",
    "        \n",
    "    except Exception as e:\n",
    "        print(f\"  Fehler bei {igc_path}: {e}\")\n",
    "        tracks_skipped += 1\n",
    "\n",
    "print(f\"\\nIGC-Tracks: {tracks_added} hinzugefügt, {tracks_skipped} übersprungen\")"
   ]
