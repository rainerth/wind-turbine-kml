    "\n",
    "# Landebahn\n",
    "landebahn_coords = [\n",
    "    (8.531799515709411, 48.22788047237495, 0),\n",
    "    (8.531791237373254, 48.22746570381057, 0),\n",
    "    (8.537614083339131, 48.22746248646123, 0),\n",
