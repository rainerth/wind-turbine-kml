    "    # Turbinen-Daten für HTML sammeln\n",
    "    turbines_js = []\n",
    "    for csv_file in glob.glob('locations/*.csv'):\n",
    "        try:\n",
    "            df = csv2df(csv_file)\n",
    "            visible_turbines = df[df['visible'] == 1]\n",
    "            \n",
    "            for _, row in visible_turbines.iterrows():\n",
    "                glb_model = row['Model'].replace('.dae', '.glb')\n",
    "                asset_id = CESIUM_ASSET_IDS.get(glb_model)\n",
    "                \n",
    "                if asset_id:\n",
    "                    turbines_js.append({\n",
    "                        'name': row['Name'],\n",
    "                        'lon': row['Longitude'],\n",
    "                        'lat': row['Latitude'],\n",
    "                        'height': row['height'],\n",
    "                        'assetId': asset_id\n",
    "                    })\n",
    "        except:\n",
    "            pass\n",
    "    \n",
    "    # Windvorranggebiete aus Shapefile für HTML\n",
    "    wvg_coords_js = {}\n",
    "    wka_shp_path = \"areas/RVSBH_Teilplan_WKA/pg_8174_windenergie.shp\"\n",
    "    try:\n",
    "        gdf_wka_html = gpd.read_file(wka_shp_path).to_crs(epsg=4326)\n",
    "        gdf_wka_html = gdf_wka_html.cx[\n",
    "            CONFIG['area_lon_min']:CONFIG['area_lon_max'],\n",
    "            CONFIG['area_lat_min']:CONFIG['area_lat_max']\n",
    "        ]\n",
    "        for idx, row in gdf_wka_html.iterrows():\n",
    "            geom = row.geometry\n",
    "            nr = row.get('nr', idx)\n",
    "            \n",
    "            if geom.geom_type == 'MultiPolygon':\n",
    "                polygons = list(geom.geoms)\n",
    "            else:\n",
    "                polygons = [geom]\n",
    "            \n",
    "            for i, poly in enumerate(polygons):\n",
    "                coords = []\n",
    "                for coord in poly.exterior.coords:\n",
    "                    coords.extend([coord[0], coord[1], 0])\n",
    "                key = f\"wvg{nr}\" if len(polygons) == 1 else f\"wvg{nr}_{i}\"\n",
    "                wvg_coords_js[key] = coords\n",
    "    except Exception as e:\n",
    "        print(f\"  WKA für HTML: {e}\")\n",
    "        # Fallback auf CSV\n",
    "        for wvg_file in sorted(glob.glob('areas/windvorranggebiet_*.csv')):\n",
    "            basename = os.path.splitext(os.path.basename(wvg_file))[0]\n",
    "            number = basename.split('_')[-1]\n",
    "            try:\n",
    "                df = pd.read_csv(wvg_file)\n",
    "                coords = []\n",
    "                for _, row in df.iterrows():\n",
    "                    coords.extend([row['Longitude'], row['Latitude'], row['Altitude']])\n",
    "                wvg_coords_js[f'wvg{number}'] = coords\n",
    "            except:\n",
    "                pass\n",
    "    \n",
    "    # FFPV-Gebiete für HTML (aus Shapefile)\n",
    "    ffpv_coords_js = {}\n",
    "    ffpv_shp_path = \"areas/RVSBH_Teilplan_FFPV/RVSBH_Teilplan_FFPV Stand n2_Bet/RVSBH_Teilplan_FFPV_Stand_n2_Bet.shp\"\n",
    "    try:\n",
    "        gdf_pv_html = gpd.read_file(ffpv_shp_path).to_crs(epsg=4326)\n",
    "        gdf_pv_html = gdf_pv_html.cx[\n",
    "            CONFIG['area_lon_min']:CONFIG['area_lon_max'],\n",
    "            CONFIG['area_lat_min']:CONFIG['area_lat_max']\n",
    "        ]\n",
    "        for idx, row in gdf_pv_html.iterrows():\n",
    "            geom = row.geometry\n",
    "            name = row.get('Bez', f\"PV-{row.get('Gebietsnum', idx)}\")\n",
    "            gebietsnum = row.get('Gebietsnum', str(idx))\n",
    "            \n",
    "            if geom.geom_type == 'MultiPolygon':\n",
    "                polygons = list(geom.geoms)\n",
    "            else:\n",
    "                polygons = [geom]\n",
    "            \n",
    "            for i, poly in enumerate(polygons):\n",
    "                coords = []\n",
    "                for coord in poly.exterior.coords:\n",
    "                    coords.extend([coord[0], coord[1], 0])\n",
    "                key = f\"ffpv_{gebietsnum}\" if len(polygons) == 1 else f\"ffpv_{gebietsnum}_{i}\"\n",
    "                ffpv_coords_js[key] = {'name': name, 'coords': coords}\n",
    "    except Exception as e:\n",
    "        print(f\"  FFPV für HTML: {e}\")\n",
    "    \n",
    "    # HTML generieren\n",
    "    html_content = f'''<!DOCTYPE html>\n",
    "<html lang=\"de\">\n",
    "<head>\n",
    "    <meta charset=\"UTF-8\">\n",
    "    <title>Windpark Bösingen - Cesium</title>\n",
    "    <script src=\"https://cesium.com/downloads/cesiumjs/releases/1.114/Build/Cesium/Cesium.js\"></script>\n",
    "    <link href=\"https://cesium.com/downloads/cesiumjs/releases/1.114/Build/Cesium/Widgets/widgets.css\" rel=\"stylesheet\">\n",
    "    <style>\n",
    "        html, body, #cesiumContainer {{ width: 100%; height: 100%; margin: 0; padding: 0; overflow: hidden; }}\n",
    "    </style>\n",
    "</head>\n",
    "<body>\n",
    "    <div id=\"cesiumContainer\"></div>\n",
    "    <script>\n",
    "        // Cesium ion Access Token (Read-Only)\n",
    "        Cesium.Ion.defaultAccessToken = '{cesium_token}';\n",
    "\n",
    "        const viewer = new Cesium.Viewer(\"cesiumContainer\", {{\n",
    "            terrain: Cesium.Terrain.fromWorldTerrain()\n",
    "        }});\n",
    "\n",
    "        // Rotor heading (225° = Southwest)\n",
    "        const rotorHeading = Cesium.Math.toRadians({ROTOR_ORIENTATION});\n",
    "        const hpr = new Cesium.HeadingPitchRoll(rotorHeading, 0, 0);\n",
    "\n",
    "        // Turbine data\n",
    "        const turbines = {json.dumps(turbines_js)};\n",
    "\n",
    "        // Add turbines\n",
    "        turbines.forEach(t => {{\n",
    "            const position = Cesium.Cartesian3.fromDegrees(t.lon, t.lat, 0);\n",
    "            const orientation = Cesium.Transforms.headingPitchRollQuaternion(position, hpr);\n",
    "\n",
    "            Cesium.IonResource.fromAssetId(t.assetId).then(resource => {{\n",
    "                viewer.entities.add({{\n",
    "                    name: t.name,\n",
    "                    position: position,\n",
    "                    orientation: orientation,\n",
    "                    model: {{\n",
    "                        uri: resource,\n",
    "                        heightReference: Cesium.HeightReference.CLAMP_TO_GROUND,\n",
    "                        minimumPixelSize: 64\n",
    "                    }}\n",
    "                }});\n",
    "            }});\n",
    "        }});\n",
    "\n",
    "        // Wind priority areas (RVSBH Shapefile) - Yellow\n",
    "        const wvgCoords = {json.dumps(wvg_coords_js)};\n",
    "\n",
    "        Object.entries(wvgCoords).forEach(([id, coords]) => {{\n",
    "            const positions = Cesium.Cartesian3.fromDegreesArray(coords);\n",
    "            viewer.entities.add({{\n",
    "                name: \"Windvorranggebiet \" + id.replace(\"wvg\", \"\"),\n",
    "                polygon: {{\n",
    "                    hierarchy: positions,\n",
    "                    material: Cesium.Color.YELLOW.withAlpha(0.3),\n",
    "                    outline: true,\n",
    "                    outlineColor: Cesium.Color.RED,\n",
    "                    outlineWidth: 2\n",
    "                }}\n",
    "            }});\n",
    "        }});\n",
    "\n",
    "        // FFPV areas (polygons) - Orange\n",
    "        const ffpvData = {json.dumps(ffpv_coords_js)};\n",
    "\n",
    "        Object.entries(ffpvData).forEach(([id, data]) => {{\n",
    "            const positions = Cesium.Cartesian3.fromDegreesArray(data.coords);\n",
    "            viewer.entities.add({{\n",
    "                name: \"FFPV: \" + data.name,\n",
    "                polygon: {{\n",
    "                    hierarchy: positions,\n",
    "                    material: Cesium.Color.ORANGE.withAlpha(0.3),\n",
    "                    outline: true,\n",
    "                    outlineColor: Cesium.Color.DARKORANGE,\n",
    "                    outlineWidth: 2\n",
    "                }}\n",
    "            }});\n",
    "        }});\n",
    "\n",
    "        // Fly to Bösingen\n",
    "        viewer.camera.flyTo({{\n",
    "            destination: Cesium.Cartesian3.fromDegrees(8.534, 48.25, 5000),\n",
    "            orientation: {{\n",
    "                heading: Cesium.Math.toRadians(0),\n",
    "                pitch: Cesium.Math.toRadians(-45),\n",
    "                roll: 0\n",
    "            }}\n",
    "        }});\n",
    "    </script>\n",
    "</body>\n",
    "</html>'''\n",
    "\n",
    "    # HTML speichern\n",
    "    output_html = './output/windpark-cesium.html'\n",
    "    with open(output_html, 'w', encoding='utf-8') as f:\n",
    "        f.write(html_content)\n",
    "    \n",
    "    print(f\"Cesium HTML-Viewer erstellt: {output_html}\")\n",
    "    print(f\"  - {len(turbines_js)} Windturbinen\")\n",
    "    print(f\"  - {len(wvg_coords_js)} Windvorranggebiete (RVSBH)\")\n",
    "    print(f\"  - {len(ffpv_coords_js)} FFPV-Gebiete\")\n",
    "    print(f\"  - Token aus .env geladen (CESIUM_ION_TOKEN_READONLY)\")\n",
    "    print(f\"\\nHinweis: Die HTML-Datei kann lokal geöffnet oder auf einem Webserver gehostet werden.\")"
   ]
  },
