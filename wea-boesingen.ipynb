   "source": [
    "# ============================================================================\n",
    "# FLUGTRACKS AUS KML-DATEIEN\n",
    "# ============================================================================\n",
    "\n",
    "folder = kml.newfolder(name='Tracks.KML')\n",
    "folder.visibility = 0\n",
    "\n",
    "kml_directory = os.path.join('tracks', 'kml')\n",
    "kml_files = glob.glob(f'{kml_directory}/*.kml')\n",
    "\n",
    "tracks_added = 0\n",
    "tracks_skipped = 0\n",
    "\n",
    "for kml_path in kml_files:\n",
    "    try:\n",
    "        track, flight_url, flight_name = kml_extract_launch_phase(\n",
    "            kml_path, min_altitude=710, max_altitude=1500, min_climb_rate=0\n",
    "        )\n",
    "        \n",
    "        if track is None:\n",
    "            tracks_skipped += 1\n",
    "            continue\n",
    "            \n",
    "        coordinates = track[['Longitude', 'Latitude', 'Altitude']].values.tolist()\n",
    "        \n",
    "        # Prüfen ob Track im definierten Gebiet liegt\n",
    "        if not is_in_area(coordinates[0][0], coordinates[0][1]):\n",
    "            print(f\"  Übersprungen (außerhalb Gebiet): {flight_name}\")\n",
    "            tracks_skipped += 1\n",
    "            continue\n",
    "        \n",
    "        create_kml_line(folder, coordinates, flight_name, flight_url, simplekml.Color.purple)\n",
    "        tracks_added += 1\n",
    "        \n",
    "    except Exception as e:\n",
    "        print(f\"  Fehler bei {kml_path}: {e}\")\n",
    "        tracks_skipped += 1\n",
    "\n",
    "print(f\"\\nKML-Tracks: {tracks_added} hinzugefügt, {tracks_skipped} übersprungen\")"
   ]
  },
