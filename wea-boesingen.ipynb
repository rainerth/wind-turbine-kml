    "# ============================================================================\n",
    "# HILFSFUNKTIONEN\n",
    "# ============================================================================\n",
    "\n",
    "def create_kml_cylinder(kmlfolder, cyl_center, cyl_diameter, cyl_height, \n",
    "                        cyl_color=simplekml.Color.green, cyl_name='cylinder', cyl_visibility=1):\n",
    "    \"\"\"Erstellt einen Zylinder als KML-Polygon (für Turbinen, Sicherheitszonen etc.)\"\"\"\n",
    "    center = cyl_center\n",
    "    radius_m = cyl_diameter / 2\n",
    "    height = cyl_height\n",
    "\n",
    "    # Umrechnung des Radius in Grad\n",
    "    radius_deg_lat = radius_m / 111139\n",
    "    radius_deg_lon = radius_deg_lat / math.cos(math.radians(center[1]))\n",
    "\n",
    "    # Koordinaten des Kreises\n",
    "    coords = []\n",
    "    for i in range(360):\n",
    "        theta = math.radians(i)\n",
    "        x = center[0] + radius_deg_lon * math.cos(theta)\n",
    "        y = center[1] + radius_deg_lat * math.sin(theta)\n",
    "        coords.append((x, y, height))\n",
    "\n",
    "    pol = kmlfolder.newpolygon(\n",
    "        name=cyl_name,\n",
    "        outerboundaryis=coords,\n",
    "        altitudemode=simplekml.AltitudeMode.relativetoground,\n",
    "        extrude=1,\n",
    "        visibility=cyl_visibility\n",
    "    )\n",
    "    pol.style.linestyle.width = 1\n",
    "    pol.style.linestyle.color = cyl_color\n",
    "    pol.style.polystyle.color = simplekml.Color.changealphaint(200, cyl_color)\n",
    "    pol.style.polystyle.outline = 1\n",
    "    pol.style.polystyle.fill = 1\n",
    "\n",
    "\n",
    "def create_kml_slope(kml_folder, start_lat, start_lon, start_altitude, \n",
    "                     direction, length, slope, width, \n",
    "                     color=simplekml.Color.yellow, name=\"slope\"):\n",
    "    \"\"\"Erstellt eine geneigte Fläche (für An-/Abflugkorridore)\"\"\"\n",
    "    transparency = 100\n",
    "    direction_rad = math.radians(direction)\n",
    "    slope_rad = math.radians(slope)\n",
    "\n",
    "    height = length * math.sin(slope_rad)\n",
    "    distance = length * math.cos(slope_rad)\n",
    "\n",
    "    half_width = width / 2\n",
    "    start_lat -= half_width * math.cos(direction_rad + math.pi / 2) / 111.32\n",
    "    start_lon -= half_width * math.sin(direction_rad + math.pi / 2) / (111.32 * math.cos(math.radians(start_lat)))\n",
    "\n",
    "    end_lat = start_lat + distance * math.cos(direction_rad) / 111.32\n",
    "    end_lon = start_lon + distance * math.sin(direction_rad) / (111.32 * math.cos(math.radians(start_lat)))\n",
    "    end_altitude = start_altitude + height * 1000\n",
    "\n",
    "    width_lat1 = start_lat + width * math.cos(direction_rad + math.pi / 2) / 111.32\n",
    "    width_lon1 = start_lon + width * math.sin(direction_rad + math.pi / 2) / (111.32 * math.cos(math.radians(start_lat)))\n",
    "    width_lat2 = end_lat + width * math.cos(direction_rad + math.pi / 2) / 111.32\n",
    "    width_lon2 = end_lon + width * math.sin(direction_rad + math.pi / 2) / (111.32 * math.cos(math.radians(end_lat)))\n",
    "\n",
    "    coordinates = [\n",
    "        (start_lon, start_lat, start_altitude),\n",
    "        (end_lon, end_lat, end_altitude),\n",
    "        (width_lon2, width_lat2, end_altitude),\n",
    "        (width_lon1, width_lat1, start_altitude),\n",
    "    ]\n",
    "\n",
    "    pol = kml_folder.newpolygon(name=name, outerboundaryis=coordinates, \n",
    "                                 altitudemode=simplekml.AltitudeMode.absolute)\n",
    "    pol.style.polystyle.color = simplekml.Color.changealphaint(transparency, color)\n",
    "    pol.style.linestyle.color = simplekml.Color.changealphaint(transparency, color)\n",
    "\n",
    "\n",
    "def create_kml_cube(kml_folder, start_lat, start_lon, start_altitude, \n",
    "                    direction, length, slope, width, \n",
    "                    color=simplekml.Color.yellow, name=\"cube\"):\n",
    "    \"\"\"Erstellt einen 3D-Quader (für Abflugbereiche)\"\"\"\n",
    "    cube_folder = kml_folder.newfolder(name='Abflugbereich')\n",
    "    cube_folder.visibility = 0\n",
    "\n",
    "    cubehight = 100\n",
    "    transparency = 80\n",
    "\n",
    "    direction_rad = math.radians(direction)\n",
    "    slope_rad = math.radians(slope)\n",
    "\n",
    "    height = length * math.sin(slope_rad)\n",
    "    distance = length * math.cos(slope_rad)\n",
    "\n",
    "    half_width = width / 2\n",
    "    start_lat -= half_width * math.cos(direction_rad + math.pi / 2) / 111.32\n",
    "    start_lon -= half_width * math.sin(direction_rad + math.pi / 2) / (111.32 * math.cos(math.radians(start_lat)))\n",
    "\n",
    "    end_lat = start_lat + distance * math.cos(direction_rad) / 111.32\n",
    "    end_lon = start_lon + distance * math.sin(direction_rad) / (111.32 * math.cos(math.radians(start_lat)))\n",
    "    end_altitude = start_altitude + height * 1000\n",
    "\n",
    "    width_lat1 = start_lat + width * math.cos(direction_rad + math.pi / 2) / 111.32\n",
    "    width_lon1 = start_lon + width * math.sin(direction_rad + math.pi / 2) / (111.32 * math.cos(math.radians(start_lat)))\n",
    "    width_lat2 = end_lat + width * math.cos(direction_rad + math.pi / 2) / 111.32\n",
    "    width_lon2 = end_lon + width * math.sin(direction_rad + math.pi / 2) / (111.32 * math.cos(math.radians(end_lat)))\n",
    "\n",
    "    lower_coordinates = [\n",
    "        (start_lon, start_lat, start_altitude),\n",
    "        (end_lon, end_lat, end_altitude),\n",
    "        (width_lon2, width_lat2, end_altitude),\n",
    "        (width_lon1, width_lat1, start_altitude),\n",
    "    ]\n",
    "    upper_coordinates = [\n",
    "        (start_lon, start_lat, start_altitude + cubehight),\n",
    "        (end_lon, end_lat, end_altitude + cubehight),\n",
    "        (width_lon2, width_lat2, end_altitude + cubehight),\n",
    "        (width_lon1, width_lat1, start_altitude + cubehight),\n",
    "    ]\n",
    "\n",
    "    sides = [\n",
    "        [lower_coordinates[0], upper_coordinates[0], upper_coordinates[1], lower_coordinates[1]],\n",
    "        [lower_coordinates[1], upper_coordinates[1], upper_coordinates[2], lower_coordinates[2]],\n",
    "        [lower_coordinates[2], upper_coordinates[2], upper_coordinates[3], lower_coordinates[3]],\n",
    "        [lower_coordinates[3], upper_coordinates[3], upper_coordinates[0], lower_coordinates[0]],\n",
    "    ]\n",
    "\n",
    "    for coords in [lower_coordinates, upper_coordinates] + sides:\n",
    "        pol = cube_folder.newpolygon(name=name, outerboundaryis=coords, \n",
    "                                      altitudemode=simplekml.AltitudeMode.absolute)\n",
    "        pol.style.polystyle.color = simplekml.Color.changealphaint(transparency, color)\n",
    "        pol.style.linestyle.color = simplekml.Color.changealphaint(transparency, color)\n",
    "        pol.visibility = 1\n",
    "\n",
    "\n",
    "def calculate_slope(speed_kmh, climb_rate_ms):\n",
    "    \"\"\"Berechnet den Steigungswinkel aus Geschwindigkeit und Steigrate\"\"\"\n",
    "    speed_ms = speed_kmh * 1000 / 3600\n",
    "    slope_rad = math.atan(climb_rate_ms / speed_ms)\n",
    "    return math.degrees(slope_rad)\n",
    "\n",
    "\n",
    "def create_kml_line(kml_folder, coordinates, flight_name, flight_url=None, \n",
    "                    color=simplekml.Color.lightblue):\n",
    "    \"\"\"Erstellt eine Linie für Flugtracks\"\"\"\n",
    "    ls = kml_folder.newlinestring(name=flight_name)\n",
    "    ls.coords = coordinates\n",
    "    ls.extrude = 0\n",
    "    ls.altitudemode = simplekml.AltitudeMode.absolute\n",
    "    ls.style.linestyle.width = 2\n",
    "    ls.style.linestyle.color = color\n",
    "    if flight_url:\n",
    "        ls.description = f'<a href=\"{flight_url}\">{flight_name}</a>'\n",
    "    else:\n",
    "        ls.description = flight_name\n",
    "    ls.visibility = 1\n",
    "\n",
    "\n",
    "def create_kml_turbine_simple(kmlfolder, center, height, diameter, name,\n",
    "                               color_tower=simplekml.Color.white,\n",
    "                               color_nacelle=simplekml.Color.lightgray,\n",
    "                               color_rotor=simplekml.Color.white,\n",
    "                               rotor_heading=225, visibility=1):\n",
    "    \"\"\"Erstellt eine vereinfachte WEA-Darstellung aus KML-Primitiven (für Google Earth Web).\n",
    "\n",
    "    Die Rotorblätter stehen vertikal in einer Ebene senkrecht zur Gondel,\n",
    "    mit dem Mittelpunkt (Nabe) an der Spitze der Gondel.\n",
    "\n",
    "    Args:\n",
    "        kmlfolder: KML-Ordner für die Geometrie\n",
    "        center: (longitude, latitude) Tuple\n",
    "        height: Nabenhöhe in Metern\n",
    "        diameter: Rotordurchmesser in Metern\n",
    "        name: Name der Turbine\n",
    "        color_tower: Farbe des Turms\n",
    "        color_nacelle: Farbe der Gondel\n",
    "        color_rotor: Farbe der Rotorblätter\n",
    "        rotor_heading: Ausrichtung der Gondel in Grad (0=Nord, Richtung in die der Rotor zeigt)\n",
    "        visibility: Sichtbarkeit (0 oder 1)\n",
    "    \"\"\"\n",
    "    lon, lat = center\n",
    "\n",
    "    # Umrechnungsfaktoren für Meter -> Grad\n",
    "    meter_to_deg_lat = 1 / 111139\n",
    "    meter_to_deg_lon = meter_to_deg_lat / math.cos(math.radians(lat))\n",
    "\n",
    "    # --- Turm als schmaler Zylinder ---\n",
    "    # Realistische Proportionen: Turm-Durchmesser ca. 2.5% des Rotordurchmessers\n",
    "    tower_diameter = max(3, diameter * 0.025)\n",
    "    tower_radius_deg_lat = (tower_diameter / 2) * meter_to_deg_lat\n",
    "    tower_radius_deg_lon = (tower_diameter / 2) * meter_to_deg_lon\n",
    "\n",
    "    tower_coords = []\n",
    "    for i in range(0, 360, 15):  # 24 Segmente für flüssigere Darstellung\n",
    "        theta = math.radians(i)\n",
    "        x = lon + tower_radius_deg_lon * math.cos(theta)\n",
    "        y = lat + tower_radius_deg_lat * math.sin(theta)\n",
    "        tower_coords.append((x, y, height))\n",
    "    tower_coords.append(tower_coords[0])  # Schließen\n",
    "\n",
    "    tower = kmlfolder.newpolygon(\n",
    "        name=f\"{name} Turm\",\n",
    "        outerboundaryis=tower_coords,\n",
    "        altitudemode=simplekml.AltitudeMode.relativetoground,\n",
    "        extrude=1,\n",
    "        visibility=visibility\n",
    "    )\n",
    "    tower.style.polystyle.color = simplekml.Color.changealphaint(220, color_tower)\n",
    "    tower.style.linestyle.color = color_tower\n",
    "    tower.style.linestyle.width = 1\n",
    "\n",
    "    # --- Gondel als Box ---\n",
    "    # Realistische Proportionen basierend auf Herstellerdaten\n",
    "    nacelle_length = max(8, diameter * 0.07)   # Ca. 7% des Rotordurchmessers (12m bei V172)\n",
    "    nacelle_width = max(3, diameter * 0.025)   # Ca. 2.5% (4.3m bei V172)\n",
    "    nacelle_height = max(3, diameter * 0.025)  # Ca. 2.5% (4.3m bei V172)\n",
    "\n",
    "    # Gondel in Rotorrichtung ausrichten\n",
    "    heading_rad = math.radians(rotor_heading)\n",
    "\n",
    "    # 4 Eckpunkte der Gondel\n",
    "    half_len = nacelle_length / 2\n",
    "    half_wid = nacelle_width / 2\n",
    "\n",
    "    # Lokale Koordinaten -> Globale Koordinaten mit Rotation\n",
    "    def rotate_point(dx, dy):\n",
    "        rx = dx * math.cos(heading_rad) - dy * math.sin(heading_rad)\n",
    "        ry = dx * math.sin(heading_rad) + dy * math.cos(heading_rad)\n",
    "        return (lon + rx * meter_to_deg_lon, lat + ry * meter_to_deg_lat)\n",
    "\n",
    "    # Gondel-Eckpunkte\n",
    "    p1 = rotate_point(-half_len, -half_wid)\n",
    "    p2 = rotate_point(half_len, -half_wid)\n",
    "    p3 = rotate_point(half_len, half_wid)\n",
    "    p4 = rotate_point(-half_len, half_wid)\n",
    "\n",
    "    nacelle_top = [\n",
    "        (p1[0], p1[1], height + nacelle_height),\n",
    "        (p2[0], p2[1], height + nacelle_height),\n",
    "        (p3[0], p3[1], height + nacelle_height),\n",
    "        (p4[0], p4[1], height + nacelle_height),\n",
    "        (p1[0], p1[1], height + nacelle_height)\n",
    "    ]\n",
    "\n",
    "    # Gondel Oberseite mit Extrusion nach unten\n",
    "    nacelle = kmlfolder.newpolygon(\n",
    "        name=f\"{name} Gondel\",\n",
    "        outerboundaryis=nacelle_top,\n",
    "        altitudemode=simplekml.AltitudeMode.relativetoground,\n",
    "        extrude=1,\n",
    "        visibility=visibility\n",
    "    )\n",
    "    nacelle.style.polystyle.color = simplekml.Color.changealphaint(220, color_nacelle)\n",
    "    nacelle.style.linestyle.color = color_nacelle\n",
    "\n",
    "    # --- Rotorblätter als vertikale Linien ---\n",
    "    # Die Rotorebene steht senkrecht zur Erdoberfläche und senkrecht zur Gondel\n",
    "    blade_length = diameter / 2\n",
    "\n",
    "    # Hub (Nabe) ist an der Vorderseite der Gondel\n",
    "    hub_offset = nacelle_length / 2\n",
    "    hub_dx = hub_offset * math.sin(heading_rad)\n",
    "    hub_dy = hub_offset * math.cos(heading_rad)\n",
    "    hub_lon = lon + hub_dx * meter_to_deg_lon\n",
    "    hub_lat = lat + hub_dy * meter_to_deg_lat\n",
    "    hub_height = height + nacelle_height / 2\n",
    "\n",
    "    # Richtung senkrecht zur Gondel (horizontale Achse der Rotorebene)\n",
    "    perp_heading_rad = heading_rad + math.pi / 2\n",
    "\n",
    "    for blade_num in range(3):\n",
    "        # Winkel im Rotorkreis (0° = oben, dann 120°, 240°)\n",
    "        blade_angle = blade_num * 120\n",
    "        blade_rad = math.radians(blade_angle)\n",
    "\n",
    "        # Vertikale Komponente (Höhenänderung relativ zur Nabe)\n",
    "        vertical_offset = blade_length * math.cos(blade_rad)\n",
    "\n",
    "        # Horizontale Komponente (senkrecht zur Gondel, in der Rotorebene)\n",
    "        horizontal_offset = blade_length * math.sin(blade_rad)\n",
    "\n",
    "        # Blattspitze berechnen\n",
    "        tip_dx = horizontal_offset * math.sin(perp_heading_rad)\n",
    "        tip_dy = horizontal_offset * math.cos(perp_heading_rad)\n",
    "\n",
    "        blade_coords = [\n",
    "            (hub_lon, hub_lat, hub_height),\n",
    "            (hub_lon + tip_dx * meter_to_deg_lon, \n",
    "             hub_lat + tip_dy * meter_to_deg_lat, \n",
    "             hub_height + vertical_offset)\n",
    "        ]\n",
    "\n",
    "        blade = kmlfolder.newlinestring(\n",
    "            name=f\"{name} Rotor {blade_num + 1}\",\n",
    "            coords=blade_coords,\n",
    "            altitudemode=simplekml.AltitudeMode.relativetoground\n",
    "        )\n",
    "        blade.style.linestyle.color = color_rotor\n",
    "        blade.style.linestyle.width = 3\n",
    "        blade.visibility = visibility\n",
    "\n",
    "\n",
    "def csv2df(filename):\n",
    "    \"\"\"Lädt CSV-Datei und bereinigt Koordinatendaten\"\"\"\n",
    "    df = pd.read_csv(filename, sep=',', decimal='.', header=0)\n",
    "    df = df.dropna(axis=0, subset=['Latitude', 'Longitude'])\n",
    "    df = df[df['Latitude'] != '']\n",
    "    df = df[df['Longitude'] != '']\n",
    "    df['Latitude'] = df['Latitude'].astype(np.float64)\n",
    "    df['Longitude'] = df['Longitude'].astype(np.float64)\n",
    "    \n",
    "    if 'visible' in df.columns:\n",
    "        df['visible'] = df['visible'].fillna(1).astype(int)\n",
    "    else:\n",
    "        df['visible'] = 1\n",
    "    return df\n",
    "\n",
    "\n",
    "def is_in_area(lon, lat):\n",
    "    \"\"\"Prüft ob Koordinaten im definierten Gebiet liegen\"\"\"\n",
    "    return (CONFIG['area_lat_min'] <= lat <= CONFIG['area_lat_max'] and \n",
    "            CONFIG['area_lon_min'] <= lon <= CONFIG['area_lon_max'])\n",
    "\n",
    "\n",
    "print(\"Hilfsfunktionen geladen.\")"
   ]
  },
