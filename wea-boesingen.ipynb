    "# ============================================================================\n",
    "# WINDVORRANGGEBIETE AUS SHAPEFILE LADEN (RVSBH Teilplan Windkraft)\n",
    "# ============================================================================\n",
    "# Lädt die offiziellen Windvorranggebiete aus dem RVSBH Shapefile.\n",
    "# Ersetzt die manuellen CSV-Dateien durch offizielle Geodaten.\n",
    "\n",
    "import geopandas as gpd\n",
    "\n",
    "# Shapefile-Pfad für Windenergie\n",
    "wka_shp_path = \"areas/RVSBH_Teilplan_WKA/pg_8174_windenergie.shp\"\n",
    "\n",
    "# Fallback auf CSV-Dateien wenn Shapefile nicht vorhanden\n",
    "use_shapefile = True\n",
    "\n",
    "try:\n",
    "    # Shapefile laden und nach WGS84 transformieren\n",
    "    gdf_wka = gpd.read_file(wka_shp_path)\n",
    "    gdf_wka = gdf_wka.to_crs(epsg=4326)\n",
    "    \n",
    "    # Auf relevanten Bereich filtern (Bösingen-Region)\n",
    "    gdf_wka_filtered = gdf_wka.cx[\n",
    "        CONFIG['area_lon_min']:CONFIG['area_lon_max'],\n",
    "        CONFIG['area_lat_min']:CONFIG['area_lat_max']\n",
    "    ]\n",
    "    \n",
    "    print(f\"WKA-Shapefile geladen: {len(gdf_wka)} Gebiete total (RVSBH Teilplan Windkraft)\")\n",
    "    print(f\"  -> {len(gdf_wka_filtered)} Gebiete im Projektbereich\")\n",
    "    \n",
    "    if len(gdf_wka_filtered) > 0:\n",
    "        # KML-Ordner erstellen\n",
    "        folder_wvg = kml.newfolder(name='Windvorranggebiete (RVSBH)')\n",
    "        folder_wvg.visibility = 0\n",
    "        \n",
    "        wvg_count = 0\n",
    "        for idx, row in gdf_wka_filtered.iterrows():\n",
    "            geom = row.geometry\n",
    "            nr = row.get('nr', idx)\n",
    "            name = f\"Windvorranggebiet {nr}\"\n",
    "            inkraft = row.get('inkraft', '')\n",
    "            \n",
    "            # MultiPolygon oder Polygon verarbeiten\n",
    "            if geom.geom_type == 'MultiPolygon':\n",
    "                polygons = list(geom.geoms)\n",
    "            else:\n",
    "                polygons = [geom]\n",
    "            \n",
    "            for i, poly in enumerate(polygons):\n",
    "                # Koordinaten extrahieren (exterior ring) - nur x, y verwenden\n",
    "                coords = [(coord[0], coord[1], 0) for coord in poly.exterior.coords]\n",
    "                \n",
    "                poly_name = f\"{name}\" if len(polygons) == 1 else f\"{name} ({i+1})\"\n",
    "                \n",
    "                pol = folder_wvg.newpolygon(\n",
    "                    name=poly_name,\n",
    "                    outerboundaryis=coords,\n",
    "                    altitudemode=simplekml.AltitudeMode.clamptoground\n",
    "                )\n",
    "                # Gelbe Farbe mit rotem Rand für Windvorranggebiete\n",
    "                pol.style.polystyle.color = simplekml.Color.changealphaint(100, simplekml.Color.yellow)\n",
    "                pol.style.linestyle.color = simplekml.Color.red\n",
    "                pol.style.linestyle.width = 2\n",
    "                pol.description = f\"RVSBH Nr. {nr}<br/>Inkrafttreten: {inkraft}\"\n",
    "                wvg_count += 1\n",
    "        \n",
    "        print(f\"  -> {wvg_count} Windvorranggebiet-Polygone zum KML hinzugefügt\")\n",
    "    else:\n",
    "        print(\"  -> Keine Windvorranggebiete im Projektbereich gefunden\")\n",
    "        use_shapefile = False\n",
    "        \n",
    "except FileNotFoundError:\n",
    "    print(f\"WKA-Shapefile nicht gefunden: {wka_shp_path}\")\n",
    "    print(\"  -> Verwende CSV-Dateien als Fallback\")\n",
    "    use_shapefile = False\n",
    "except Exception as e:\n",
    "    print(f\"Fehler beim Laden des WKA-Shapefiles: {e}\")\n",
    "    print(\"  -> Verwende CSV-Dateien als Fallback\")\n",
    "    use_shapefile = False\n",
    "\n",
    "# Fallback: CSV-Dateien verwenden\n",
    "if not use_shapefile:\n",
    "    folder_wvg = kml.newfolder(name='Windvorranggebiete')\n",
    "    folder_wvg.visibility = 0\n",
    "    \n",
    "    wvg_files = sorted(glob.glob('areas/windvorranggebiet_*.csv'))\n",
    "    \n",
    "    for wvg_file in wvg_files:\n",
    "        basename = os.path.splitext(os.path.basename(wvg_file))[0]\n",
    "        number = basename.split('_')[-1]\n",
    "        name = f\"Windvorranggebiet {number}\"\n",
    "        \n",
    "        try:\n",
    "            df = pd.read_csv(wvg_file)\n",
    "            coordinates = list(zip(df['Longitude'], df['Latitude'], df['Altitude']))\n",
    "            \n",
    "            pol = folder_wvg.newpolygon(\n",
    "                name=name,\n",
    "                outerboundaryis=coordinates,\n",
    "                altitudemode=simplekml.AltitudeMode.clamptoground\n",
    "            )\n",
    "            pol.style.polystyle.color = simplekml.Color.changealphaint(100, simplekml.Color.yellow)\n",
    "            pol.style.linestyle.color = simplekml.Color.red\n",
    "            pol.style.linestyle.width = 2\n",
    "            pol.description = name\n",
    "            \n",
    "            print(f\"  {name}: {len(df)} Koordinaten (CSV)\")\n",
    "        except Exception as e:\n",
    "            print(f\"  Fehler bei {wvg_file}: {e}\")\n",
    "    \n",
    "    print(f\"\\n{len(wvg_files)} Windvorranggebiete aus CSV geladen (Fallback)\")"
   ]
