    "# ============================================================================\n",
    "# COLLADA ZU GLTF KONVERTIEREN (für Cesium)\n",
    "# ============================================================================\n",
    "# Cesium verwendet glTF als natives 3D-Format. Die COLLADA-Modelle werden\n",
    "# nach GLB (binäres glTF) konvertiert für optimale Performance.\n",
    "\n",
    "import trimesh\n",
    "\n",
    "def convert_dae_to_glb(dae_path, glb_path=None):\n",
    "    \"\"\"Konvertiert eine COLLADA-Datei (.dae) nach GLB (binäres glTF).\"\"\"\n",
    "    if glb_path is None:\n",
    "        glb_path = dae_path.replace('.dae', '.glb')\n",
    "    \n",
    "    scene = trimesh.load(dae_path)\n",
    "    scene.export(glb_path, file_type='glb')\n",
    "    return glb_path\n",
    "\n",
    "# Alle DAE-Dateien konvertieren\n",
    "print(\"Konvertiere COLLADA-Modelle nach glTF...\")\n",
    "dae_files = glob.glob(f\"{CONFIG['models_dir']}/*.dae\")\n",
    "\n",
    "glb_models = {}\n",
    "for dae_file in dae_files:\n",
    "    model_name = os.path.basename(dae_file)\n",
    "    glb_file = dae_file.replace('.dae', '.glb')\n",
    "    \n",
    "    try:\n",
    "        convert_dae_to_glb(dae_file, glb_file)\n",
    "        glb_size = os.path.getsize(glb_file) / 1024\n",
    "        print(f\"  {model_name} -> {os.path.basename(glb_file)} ({glb_size:.1f} KB)\")\n",
    "        glb_models[model_name] = os.path.basename(glb_file)\n",
    "    except Exception as e:\n",
    "        print(f\"  Fehler bei {model_name}: {e}\")\n",
    "\n",
    "print(f\"\\n{len(glb_models)} Modelle konvertiert.\")"
   ]
