    "# ============================================================================\n",
    "# CZML FÜR CESIUM ERSTELLEN (mit glTF-Modellen)\n",
    "# ============================================================================\n",
    "# CZML ist Cesiums natives JSON-Format. Die Windturbinen werden als glTF-Modelle\n",
    "# referenziert für fotorealistische 3D-Darstellung.\n",
    "\n",
    "import json\n",
    "\n",
    "def create_czml_turbine_model(turbine_id, name, lon, lat, model_file, \n",
    "                               rotor_heading=225, scale=1.0):\n",
    "    \"\"\"Erstellt ein CZML-Paket für eine Windturbine mit glTF-Modell.\"\"\"\n",
    "    return {\n",
    "        \"id\": turbine_id,\n",
    "        \"name\": name,\n",
    "        \"position\": {\n",
    "            \"cartographicDegrees\": [lon, lat, 0]  # Modell steht auf dem Boden\n",
    "        },\n",
    "        \"model\": {\n",
    "            \"gltf\": f\"models/{model_file}\",\n",
    "            \"scale\": scale,\n",
    "            \"minimumPixelSize\": 64,\n",
    "            \"maximumScale\": 20000,\n",
    "            \"heightReference\": \"RELATIVE_TO_GROUND\",\n",
    "            \"silhouetteColor\": {\n",
    "                \"rgba\": [255, 255, 255, 255]\n",
    "            },\n",
    "            \"silhouetteSize\": 1.0\n",
    "        },\n",
    "        \"orientation\": {\n",
    "            \"heading\": math.radians(rotor_heading),\n",
    "            \"pitch\": 0,\n",
    "            \"roll\": 0\n",
    "        }\n",
    "    }\n",
    "\n",
    "\n",
    "def create_czml_polygon(polygon_id, name, coordinates, color=[255, 255, 0, 100], \n",
    "                        outline_color=[255, 0, 0, 255], height=0, extrude=False):\n",
    "    \"\"\"Erstellt ein CZML-Polygon-Paket.\"\"\"\n",
    "    czml_coords = []\n",
    "    for coord in coordinates:\n",
    "        czml_coords.extend([coord[0], coord[1], coord[2] if len(coord) > 2 else height])\n",
    "    \n",
    "    polygon_props = {\n",
    "        \"positions\": {\n",
    "            \"cartographicDegrees\": czml_coords\n",
    "        },\n",
    "        \"material\": {\n",
    "            \"solidColor\": {\n",
    "                \"color\": {\n",
    "                    \"rgba\": color\n",
    "                }\n",
    "            }\n",
    "        },\n",
    "        \"outline\": True,\n",
    "        \"outlineColor\": {\n",
    "            \"rgba\": outline_color\n",
    "        },\n",
    "        \"outlineWidth\": 2\n",
    "    }\n",
    "    \n",
    "    if extrude:\n",
    "        polygon_props[\"extrudedHeight\"] = 0\n",
    "        polygon_props[\"height\"] = height\n",
    "    \n",
    "    return {\n",
    "        \"id\": polygon_id,\n",
